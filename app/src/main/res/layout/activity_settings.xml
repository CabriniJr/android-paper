<?xml version="1.0" encoding="utf-8"?>
<!-- One scrolling page of plain framework widgets, in the system's own theme. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <Switch
            android:id="@+id/master_switch"
            style="@style/MasterSwitch"
            android:text="@string/paper_mode" />

        <TextView
            android:id="@+id/status"
            style="@style/Hint" />

        <!-- One-time setup, shown until the permission is granted. -->
        <LinearLayout
            android:id="@+id/setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/Header"
                android:text="@string/setup_title" />

            <TextView
                style="@style/Hint"
                android:text="@string/setup_text" />

            <TextView
                android:id="@+id/grant_command"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:background="?android:attr/colorBackgroundFloating"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <Button
                android:id="@+id/copy_command"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/copy_command" />

            <TextView
                style="@style/Hint"
                android:text="@string/setup_wireless" />
        </LinearLayout>

        <TextView
            style="@style/Header"
            android:text="@string/section_look" />

        <LinearLayout style="@style/SliderRow">

            <TextView
                style="@style/Label"
                android:labelFor="@id/warmth_seek"
                android:text="@string/warmth" />

            <TextView
                android:id="@+id/warmth_value"
                style="@style/Value" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/warmth_seek"
            style="@style/Slider"
            android:max="100" />

        <TextView
            style="@style/Hint"
            android:text="@string/warmth_hint" />

        <Switch
            android:id="@+id/dim_switch"
            style="@style/Option"
            android:text="@string/dim" />

        <TextView
            style="@style/Hint"
            android:text="@string/dim_hint" />

        <LinearLayout
            android:id="@+id/dim_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout style="@style/SliderRow">

                <TextView
                    style="@style/Label"
                    android:labelFor="@id/dim_seek"
                    android:text="@string/dim_level" />

                <TextView
                    android:id="@+id/dim_value"
                    style="@style/Value" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/dim_seek"
                style="@style/Slider" />
        </LinearLayout>

        <Switch
            android:id="@+id/crisp_switch"
            style="@style/Option"
            android:text="@string/crisp_text" />

        <TextView
            style="@style/Hint"
            android:text="@string/crisp_text_hint" />

        <TextView
            style="@style/Header"
            android:text="@string/section_motion" />

        <Switch
            android:id="@+id/animations_switch"
            style="@style/Option"
            android:text="@string/no_animations" />

        <TextView
            style="@style/Hint"
            android:text="@string/no_animations_hint" />

        <Switch
            android:id="@+id/flash_switch"
            style="@style/Option"
            android:text="@string/page_flash" />

        <TextView
            style="@style/Hint"
            android:text="@string/page_flash_hint" />

        <LinearLayout
            android:id="@+id/flash_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout style="@style/SliderRow">

                <TextView
                    style="@style/Label"
                    android:labelFor="@id/flash_seek"
                    android:text="@string/flash_duration" />

                <TextView
                    android:id="@+id/flash_value"
                    style="@style/Value" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/flash_seek"
                style="@style/Slider" />
        </LinearLayout>

        <TextView
            style="@style/Header"
            android:text="@string/section_shortcuts" />

        <TextView
            style="@style/Hint"
            android:text="@string/shortcuts_hint" />

        <Button
            android:id="@+id/add_tile"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_tile" />

        <TextView
            style="@style/Hint"
            android:layout_marginTop="16dp"
            android:text="@string/footer" />
    </LinearLayout>
</ScrollView>
