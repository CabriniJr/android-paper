<?xml version="1.0" encoding="utf-8"?>
<!--
  Only window state changes, and no window content: the service needs to know which screen is
  open, never what's on it. It turns its own events off while the flash isn't wanted.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/page_turn_description"
    android:notificationTimeout="50"
    android:settingsActivity="com.paperscreen.SettingsActivity"
    android:summary="@string/page_turn_summary" />
